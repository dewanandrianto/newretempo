{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retempo",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "development",
    "APP_ORIGINS": "http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173",
    "SIWE_DOMAIN": "retempo.xyz",
    "SIWE_URI": "https://retempo.xyz",
    "SIWE_CHAIN_ID": "5042",
    "EMAIL_MODE": "disabled"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "retempo-local",
    "migrations_dir": "worker/migrations",
    "remote": false
  }]
}
