# RETEMPO backend configuration. Copy to .env and fill in. Never commit .env.
# Values below are placeholders. Generate real secrets yourself.

NODE_ENV=development

# PostgreSQL 16+ (18 recommended). Use a dedicated role in production.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/retempo
# Used only by `bun run test`. The database name MUST end in _test: it is wiped on every run.
TEST_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/retempo_test

# 32+ random characters (for example: openssl rand -hex 32). Peppers session / API key / email token hashes.
# Rotating it signs everyone out and invalidates issued API keys.
SESSION_SECRET=

API_PORT=3001

# Browser origins allowed to call the API with cookies (comma separated, https in production).
APP_ORIGINS=https://retempo.xyz

# Sign-In with Ethereum. The server only accepts messages with exactly this domain, URI and chain.
SIWE_DOMAIN=retempo.xyz
SIWE_URI=https://retempo.xyz
SIWE_CHAIN_ID=5042002

# `log` prints verification/reset links to the server console (development only; ignored in production).
EMAIL_MODE=disabled

# Optional overrides. Defaults: REQUIRE_VERIFIED_EMAIL and COOKIE_SECURE are true in production, false otherwise.
# REQUIRE_VERIFIED_EMAIL=true
# COOKIE_SECURE=true
# TRUST_PROXY=true            # read the client IP from X-Forwarded-For (only behind a trusted proxy)
# SESSION_TTL_HOURS=168
# SESSION_IDLE_HOURS=24
