{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "paths": { "@shared/*": ["../shared/*"] },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
