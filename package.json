{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "build": "vite build",
    "lint": "oxlint --type-aware src scripts worker && oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p backend",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "bash scripts/check-contracts-local.sh",
    "api": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "api:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "api:legacy": "bun run backend/src/server.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:legacy:migrate": "bun run backend/src/db/migrate.ts",
    "test": "node node_modules/vitest/vitest.mjs run --config worker/vitest.config.ts",
    "test:legacy": "bun test backend"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/react-auth": "3.51.3",
    "@privy-io/wagmi": "4.0.19",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "framer-motion": "^11.15.0",
    "hono": "4.13.17",
    "jose": "6.2.17",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
